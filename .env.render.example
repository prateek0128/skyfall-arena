# Manual Render Web Service settings; no production service has been created.
# Enter these in the Render dashboard. The Node entrypoint does not load this file.
NODE_VERSION=24.18.0
NODE_ENV=production
HOST=0.0.0.0
# Render supplies PORT=10000 by default. Keep its value unless deliberately changed.
PORT=10000
ALLOWED_ORIGINS=https://skyfall-arena-kappa.vercel.app
ALLOW_ORIGINLESS=false
# Leave rate limits, heartbeat, timeout and shutdown settings at their secure defaults.
# Do not add VITE_WS_URL here: it belongs to the Vercel frontend build environment.
