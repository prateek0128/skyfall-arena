# Frontend build-time public configuration. Vite loads this from .env.local.
# Set to the actual secure endpoint before a public frontend build.
# Local development/preview defaults to ws://<page hostname>:2567 when omitted.
VITE_WS_URL=wss://arena.example.com/socket

# Server-only: export in the shell/process manager. Vite's .env.local is NOT loaded by Node.
NODE_ENV=production
HOST=127.0.0.1
PORT=2567
# Required in production; exact HTTPS origins, comma-separated, no trailing slash.
ALLOWED_ORIGINS=https://game.example.com
ALLOW_ORIGINLESS=false

# Optional operational limits; defaults shown. TCP peer IP is used, never X-Forwarded-For.
MAX_CONNECTIONS_PER_IP=32
IP_UPGRADE_BURST=40
IP_ROOM_COMMAND_BURST=60
HEARTBEAT_MS=15000
SESSION_TIMEOUT_MS=10000
SHUTDOWN_MS=5000
LOG_INTERVAL_MS=30000
